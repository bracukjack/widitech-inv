# Salin file ini menjadi .env.local lalu isi nilainya.

# Koneksi PostgreSQL
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgres://postgres:password@localhost:5432/widitech_invoice

# Akun master admin — dibuat oleh `npm run db:seed` (hanya jika email ini belum terdaftar)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ganti-dengan-password-kuat
ADMIN_NAME=Master Admin
